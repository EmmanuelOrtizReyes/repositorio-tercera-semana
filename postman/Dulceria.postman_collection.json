{
  "info": { "name": "Dulcería Emma", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:3000" }, { "key": "token", "value": "" }, { "key": "productId", "value": "1" }],
  "item": [
    { "name": "Auth", "item": [
      { "name": "Registro", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Cliente Demo\",\n  \"email\": \"demo@dulces.test\",\n  \"password\": \"password123\"\n}" }, "url": "{{baseUrl}}/auth/register" } },
      { "name": "Login", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"demo@dulces.test\",\n  \"password\": \"password123\"\n}" }, "url": "{{baseUrl}}/auth/login" } }
    ] },
    { "name": "Products", "item": [
      { "name": "Listar productos", "request": { "method": "GET", "url": "{{baseUrl}}/products" } },
      { "name": "Crear producto", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Mazapán\",\n  \"description\": \"Mazapán de cacahuate\",\n  \"price\": 8.50,\n  \"stock\": 50,\n  \"category\": \"Dulces tradicionales\"\n}" }, "url": "{{baseUrl}}/products" } },
      { "name": "Obtener producto", "request": { "method": "GET", "url": "{{baseUrl}}/products/{{productId}}" } }
    ] },
    { "name": "Sales", "item": [
      { "name": "Registrar venta", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "raw", "raw": "{\n  \"items\": [\n    { \"productId\": 1, \"quantity\": 2 },\n    { \"productId\": 2, \"quantity\": 1 }\n  ]\n}" }, "url": "{{baseUrl}}/sales" } }
    ] }
  ]
}
